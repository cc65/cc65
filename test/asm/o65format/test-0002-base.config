MEMORY {
	ZP:  start =   $00, size = $00FF;
	RAM: start = $0000, size = $04FF;
}

SEGMENTS {
	CODE:     load = RAM, type = ro;
	DATA:     load = RAM, type = rw;
	BSS:      load = RAM, type = bss, define = yes;
	ZEROPAGE: load = ZP,  type = zp;
}

FILES {
	%O: format = o65;
}

FORMATS {
	o65:
		os = opencbm,
		version = 0,
		type = small,
		import = IMPORTED,
		export = EXPORTED;
}

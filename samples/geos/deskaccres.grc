MENU mainMenu 80,64 HORIZONTAL
{
    "file" SUB_MENU fileSubMenu
    "edit" SUB_MENU editSubMenu
}

MENU fileSubMenu mainMenu:file VERTICAL
{
    "close" MENU_ACTION DoClose
    "quit" MENU_ACTION DoQuit
}

MENU editSubMenu mainMenu:edit VERTICAL
{
    "cut" MENU_ACTION DoCut
    "copy" MENU_ACTION DoCopy
    "paste" MENU_ACTION DoPaste
}

HEADER DESK_ACC "deskacc" "DeskAcc Demo" "V1.0" {
    dostype USR
    info "Sample desk accessory"
    mode 40only
}
